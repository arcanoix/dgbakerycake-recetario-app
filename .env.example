# Ejemplo de variables de entorno
# Copia este archivo a .env.local para desarrollo local

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=your-database-url

# Cron Job Security
CRON_SECRET=your-cron-secret-here

# BCV Scraping API (https://python-scrapping-bcv.onrender.com)
BCV_API_KEY=your-bcv-api-key-here

# BCV API Key for client-side sync (must start with NEXT_PUBLIC_)
NEXT_PUBLIC_BCV_API_KEY=your-bcv-api-key-here

# OpenAI API Key (for AI Premium features using GPT)
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (for AI Premium features using Claude)
# Obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini API Key (for AI Premium features using Gemini)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# AI Provider selector — choose one: openai | anthropic | gemini
# If not set, the first key found above is used automatically.
AI_PROVIDER=openai

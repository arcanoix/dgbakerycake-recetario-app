# Ejemplo de variables de entorno
# Copia este archivo a .env.local para desarrollo local

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=your-database-url

# Cron Job Security
CRON_SECRET=your-cron-secret-here

# BCV Scraping API (https://python-scrapping-bcv.onrender.com)
BCV_API_KEY=your-bcv-api-key-here

# BCV API Key for client-side sync (must start with NEXT_PUBLIC_)
NEXT_PUBLIC_BCV_API_KEY=your-bcv-api-key-here
